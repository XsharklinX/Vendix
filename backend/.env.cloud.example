NODE_ENV=production
PORT=3100

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vendix?schema=public

# Security
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-frontend-domain.com

# Optional cloud flags
VENDIX_CLOUD_MODE=true
VENDIX_SYNC_ENABLED=false
VENDIX_CLOUD_BACKUPS=false

# Optional local/cloud sync worker
# Set these on the local desktop backend only when you want automatic sync.
VENDIX_CLOUD_URL=https://your-cloud-api.example.com
VENDIX_CLOUD_TOKEN=replace-with-cloud-user-jwt
VENDIX_SYNC_BUSINESS_ID=local-and-cloud-business-id-if-same
VENDIX_SYNC_LOCAL_BUSINESS_ID=
VENDIX_SYNC_CLOUD_BUSINESS_ID=
VENDIX_SYNC_DEVICE_KEY=desktop-main
VENDIX_SYNC_DEVICE_NAME=Caja principal
VENDIX_SYNC_INTERVAL_MS=60000

# Email/backups if enabled
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
