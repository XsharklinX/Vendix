{
  "name": "vendix",
  "version": "1.1.0",
  "description": "Sistema de gestión de ventas para pequeños negocios",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "concurrently -n BACK,FRONT,ELECTRON -c blue,green,cyan \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && node scripts/launch-dev.js\"",

    "setup": "npm run setup:backend && npm run setup:frontend && npm install",
    "setup:backend": "cd backend && npm install && npx prisma generate && npx prisma db push",
    "setup:frontend": "cd frontend && npm install",

    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:seed": "node scripts/create-seed-db.js",
    "build:prune": "cd backend && npm prune --omit=dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:seed && npm run build:electron && npm run build:prune",

    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.vendix.app",
    "productName": "Vendix",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "backend/dist",             "to": "backend/dist" },
      { "from": "backend/node_modules",     "to": "backend/node_modules" },
      { "from": "backend/prisma/schema.prisma", "to": "backend/prisma/schema.prisma" },
      { "from": "frontend/dist",            "to": "frontend/dist" },
      { "from": "electron/assets/seed.db",  "to": "electron/assets/seed.db" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vendix",
      "deleteAppDataOnUninstall": false
    },
    "compression": "store",
    "portable": {
      "artifactName": "Vendix-Portable-${version}.exe"
    }
  }
}
